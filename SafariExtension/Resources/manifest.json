{
  "manifest_version": 3,
  "name": "Claude iOS 17 Fix",
  "description": "Stops claude.ai crashing Safari on iOS 17.3 by correcting the CSS that WebKit can't handle.",
  "version": "1.0",
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png",
    "256": "icon-256.png",
    "512": "icon-512.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*.claude.ai/*", "https://*.claude.com/*", "https://*.anthropic.com/*"],
      "js": ["host.js", "style-fix.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://*.claude.ai/*", "https://*.claude.com/*", "https://*.anthropic.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "own_style_sheets", "enabled": true, "path": "rules.json" }
    ]
  }
}
